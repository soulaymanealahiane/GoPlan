OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
AI_ACCESS_CODE=

# Optional: off disables live research; defaults to enabled.
OPENAI_WEB_RESEARCH=on
# The first recommendation uses reviewed market evidence. Optional live refresh:
OPENAI_DIRECTION_RESEARCH=off
# Balanced interactive configuration with bounded public-source discovery.
OPENAI_REASONING_EFFORT=medium
OPENAI_RESEARCH_MODEL=gpt-6-luna
OPENAI_RESEARCH_REASONING_EFFORT=none

# Private reviewer access; use a distinct random secret, never the student demo code.
FEEDBACK_REVIEW_KEY=

# Aggregate usage counters (no student identifiers or plan contents).
ANALYTICS_ENABLED=false
# Optional separate dashboard credential; defaults to FEEDBACK_REVIEW_KEY.
ANALYTICS_ADMIN_KEY=

# Email sign-in: Supabase project URL and publishable key (not service-role key).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated verified email addresses allowed into /admin.
ADMIN_EMAILS=

# Each contracted university uses its own deployment, DB and academic data.
# Keep the pitching demo in demo mode; roster mode fails closed without a list.
GOPLAN_ACCESS_MODE=demo
GOPLAN_UNIVERSITY_ID=
GOPLAN_EMAIL_DOMAINS=
